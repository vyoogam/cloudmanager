#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
version="$(cat VERSION)"
[[ "$version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || {
  echo "VERSION must contain stable semver without a v prefix" >&2
  exit 1
}
commit="$(git rev-parse --short HEAD)"
dirty=""
[[ -z "$(git status --porcelain --untracked-files=normal)" ]] || dirty=".dirty"
if [[ "$(git describe --exact-match --tags HEAD 2>/dev/null || true)" == "v${version}" && -z "$dirty" ]]; then
  printf '%s\n' "$version"
else
  printf '%s-dev.%s%s\n' "$version" "$commit" "$dirty"
fi
