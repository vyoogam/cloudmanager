#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ $# == 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
  echo "Usage: scripts/release <vX.Y.Z>"
  echo "Updates VERSION on a clean Features/*, fixes/*, or dev/* branch. Review and commit it, then open a PR into release/v1."
  exit 0
fi
[[ $# == 1 ]] || { echo "Usage: scripts/release <vX.Y.Z>" >&2; exit 2; }
version="${1#v}"
[[ "$version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || {
  echo "release: expected stable semver, for example v1.0.3" >&2
  exit 2
}
case "$(git branch --show-current)" in
  Features/*|fixes/*|dev/*) ;;
  *) echo "release: prepare releases on a Features/*, fixes/*, or dev/* branch" >&2; exit 1 ;;
esac
[[ -z "$(git status --porcelain)" ]] || {
  echo "release: commit or stash your work before preparing a version" >&2
  exit 1
}
if git rev-parse --verify "refs/tags/v${version}" >/dev/null 2>&1; then
  echo "release: tag v${version} already exists; choose a new version" >&2
  exit 1
fi
printf '%s\n' "$version" > VERSION
echo "Prepared VERSION=${version}. Review and commit VERSION, then push your branch explicitly to origin."
echo "Open a PR into release/v1. After merge, run Release Go Module from release/v1."
